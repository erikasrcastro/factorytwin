<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="factory_cell">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <model name="factory_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="conveyor">
      <static>true</static>
      <pose>0 0 0.55 0 0 0</pose>
      <link name="belt_link">
        <collision name="belt_collision">
          <geometry>
            <box>
              <size>6 1.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="belt_visual">
          <geometry>
            <box>
              <size>6 1.2 0.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.1 0.2 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
<model name="peca_01">
  <static>false</static>
  <pose>0 0 1.5 0 0 0</pose>

  <link name="corpo_peca">
    <inertial>
      <mass>1.0</mass>
      <inertia>
        <ixx>0.026667</ixx>
        <iyy>0.026667</iyy>
        <izz>0.026667</izz>
      </inertia>
    </inertial>

    <collision name="colisao_peca">
      <geometry>
        <box>
          <size>0.4 0.4 0.4</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual_peca">
      <geometry>
        <box>
          <size>0.4 0.4 0.4</size>
        </box>
      </geometry>
      <material>
        <ambient>1 0.5 0.1 1</ambient>
        <diffuse>1 0.5 0.1 1</diffuse>
      </material>
    </visual>
  </link>
</model>
  </world>
</sdf>

